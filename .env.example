# Resend API Configuration for Project Inquiries
RESEND_API_KEY=your_resend_api_key
RESEND_TO_EMAIL=your_email@example.com
RESEND_FROM_EMAIL="Portfolio Inquiry <onboarding@resend.dev>"

# Optional client-side fallback keys. These are exposed to the browser, so use
# only provider keys intended for public client-side use.
VITE_WEB3FORMS_KEY=
VITE_FORMSPREE_KEY=
